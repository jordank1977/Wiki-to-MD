# ==============================================================================
# Wiki-to-RAG Sync Engine Configuration Example
# Copy this file to '.env' in the same directory and customize the values.
# ==============================================================================

# Background Watcher Polling Interval (in seconds)
# Determines how frequently the background worker polls the MediaWiki
# 'recentchanges' API to check for updates. Default is 1800 (30 minutes).
WATCHER_POLL_INTERVAL=1800
